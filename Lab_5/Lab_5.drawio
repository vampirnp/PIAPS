    <mxGraphModel dx="2255" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classFontSize 13\nskinparam nodesep 50\nskinparam ranksep 30\n\ninterface Expression {\n  + interpret(context: String): String\n}\n\nclass TextEditor {\n  - expressions: List&lt;Expression&gt;\n  + correctText(text: String): String\n}\n\nclass MultipleSpacesExpression\nclass HyphenToDashExpression\nclass QuoteReplacementExpression\nclass TabFixExpression\nclass SpaceFixExpression\nclass MultipleNewlinesExpression\n\nExpression &lt;|.. MultipleSpacesExpression\nExpression &lt;|.. HyphenToDashExpression\nExpression &lt;|.. QuoteReplacementExpression\nExpression &lt;|.. TabFixExpression\nExpression &lt;|.. SpaceFixExpression\nExpression &lt;|.. MultipleNewlinesExpression\n\nTextEditor o--&gt; Expression : содержит\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="lsi_P6oNGd4UzXnzWbCy-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-240" y="290" width="1225.45" height="260" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor User\nparticipant \&quot;TextEditor\&quot; as TE\nparticipant \&quot;Expression\&quot; as Expr\n\nUser -&gt; TE: correctText(text)\nactivate TE\n\nloop Для каждого правила\n  TE -&gt; Expr: interpret(context)\n  activate Expr\n  Expr --&gt; TE: модифицированный текст\n  deactivate Expr\nend\n\nTE --&gt; User: исправленный текст\ndeactivate TE\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="lsi_P6oNGd4UzXnzWbCy-2">
