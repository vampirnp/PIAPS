        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Система\nparticipant PerformanceMonitor\nparticipant Deanery\nactor Кафедра\n\nСистема -&gt; PerformanceMonitor: weeklyCheck()\nPerformanceMonitor -&gt; Deanery: update()\nDeanery -&gt; Кафедра: notifyDepartment()\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="FlSIWW7kaWnMSYmjMFIN-2">
