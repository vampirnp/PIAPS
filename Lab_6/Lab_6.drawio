        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ninterface Subject {\n    + registerObserver(Observer o)\n    + removeObserver(Observer o)\n    + notifyObservers()\n}\n\ninterface Observer {\n    + update()\n}\n\nclass PerformanceMonitor {\n    - observers: List&lt;Observer&gt;\n    - dataSubmitted: boolean\n    + submitPerformance(Teacher teacher)\n    + weeklyCheck()\n}\n\nclass Deanery {\n    + update()\n    + notifyDepartment()\n}\n\nclass Teacher {\n    - name: String\n    + submitPerformance(PerformanceMonitor monitor)\n}\n\nSubject &lt;|.. PerformanceMonitor\nObserver &lt;|.. Deanery\n\nPerformanceMonitor \&quot;1\&quot; *-- \&quot;many\&quot; Observer : observers\nTeacher --&gt; PerformanceMonitor : submits to\nDeanery --&gt; \&quot;Department\&quot; : notifies\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="FlSIWW7kaWnMSYmjMFIN-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
